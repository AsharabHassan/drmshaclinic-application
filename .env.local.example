# ─────────────────────────────────────────────────────────────
# Dr M Sha — Veluria skin-scan funnel
#
# Copy to .env.local and fill in. .env.local is gitignored; never commit it.
#   cp .env.local.example .env.local
#
# Covers every variable this app reads. Anything under "optional" has a
# working code default, shown in its comment — leave it unset to take that.
# ─────────────────────────────────────────────────────────────

# ── Required — the funnel cannot produce a report without these ──

# Anthropic — the written skin analysis (Claude vision)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — the before/after image (gpt-image-2 edits endpoint)
OPENAI_API_KEY=sk-...


# ── CRM + report delivery (optional — flow completes without them) ──

# GoHighLevel inbound webhook URL (Workflows -> Inbound Webhook trigger)
# Leads are POSTed here as JSON before results are revealed.
GHL_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/...

# --- GoHighLevel v2 API — email the report PDF when a customer books ---
# NOTE: this app uses GHL_API_KEY. The other four forks call the same thing
# GHL_API_TOKEN — don't copy a value across without renaming it.
# Private Integration token (pit-...). NEVER commit the real value.
GHL_API_KEY=
# GHL sub-account (location) id
GHL_LOCATION_ID=
# Contact custom-field KEY that stores the report's media URL (used to write it)
GHL_REPORT_FIELD_KEY=facial_report_pdf
# Contact custom-field ID for the same field (used to read it back — GET returns
# customFields as {id, value} with no key). Find it once by writing the field via
# the API and reading the response, or in GHL's custom-field settings.
GHL_REPORT_FIELD_ID=
# Booking calendar link used in the report email's CTA button (optional; falls
# back to the free-online-phone-consultation link).
GHL_BOOKING_URL=
# "From" address for the report email. Must be a verified sender/domain in GHL.
# If unset, GHL uses the location's default sending address.
GHL_EMAIL_FROM=info@drmshaclinic.com
# Sender display name shown to recipients (defaults to "Dr. M Sha Clinic").
GHL_EMAIL_FROM_NAME=Dr. M Sha Clinic
# Optional API base override. Default: https://services.leadconnectorhq.com
# GHL_API_BASE=https://services.leadconnectorhq.com


# ── Public URLs and tracking (NEXT_PUBLIC_* ship to the browser) ──

# Where the "Book a consultation" button sends users.
# This is Sirona's domain because this build doubles as the Sirona demo.
NEXT_PUBLIC_BOOKING_URL=https://sironaaesthetics.co.uk

# Booking calendar URL for the "Book a Free Consultation" CTA
# (free online phone consultation). Falls back to a default if unset.
NEXT_PUBLIC_CALENDAR_URL=

# Meta (Facebook) Pixel ID — used for PageView + Lead events and the
# Conversions API fields forwarded to GHL. Demo: leave unset/replace with the
# Sirona pixel before any real campaign.
NEXT_PUBLIC_META_PIXEL_ID=

# NOTE: this app does NOT read NEXT_PUBLIC_SITE_URL (the other four do).
# Setting it here has no effect.


# ── Image generation tuning (optional — all have defaults) ──

# Candidates generated per after-image, best-of picked by the verifier. Default: 4
# AFTER_CANDIDATES=4
# Streamed partial images per candidate. Default: 3
# AFTER_PARTIAL_IMAGES=3
# Wall-clock budget for the whole after-image step, ms. The route must finish
# inside the platform's 300s ceiling. Default: 240000
# AFTER_MAX_WAIT_MS=240000
# Quality tier: low | medium | high. Default: medium
# AFTER_QUALITY=medium
# Quality for the one retry when the first pass is rejected. Default: medium
# AFTER_RESCUE_QUALITY=medium
# Post-process strength, 0 disables. Defaults: 2 and 2
# GLOW_STRENGTH=2
# FIRMNESS_STRENGTH=2
